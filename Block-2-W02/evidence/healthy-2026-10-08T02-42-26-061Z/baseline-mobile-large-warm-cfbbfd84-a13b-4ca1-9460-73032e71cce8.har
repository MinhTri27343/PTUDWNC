3000"},{"name":"Cache-Control","value":"no-store"},{"name":"Connection","value":"keep-alive"},{"name":"Content-Length","value":"1390"},{"name":"Content-Type","value":"text/html; charset=utf-8"},{"name":"Date","value":"Thu, 08 Oct 2026 02:42:50 GMT"},{"name":"ETag","value":"W/\"56e-1a1195ca106\""},{"name":"Keep-Alive","value":"timeout=5"},{"name":"Last-Modified","value":"Thu, 08 Oct 2026 02:34:23 GMT"},{"name":"Timing-Allow-Origin","value":"http://localhost:3000"},{"name":"X-Request-Id","value":"c71f0253-c3d4-40cd-8888-52d9ae5e5a15"}],"content":{"size":1390,"mimeType":"text/html; charset=utf-8","compression":0,"text":"<!doctype html>\n<html lang=\"vi\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Baseline × BFF — API composition</title><link rel=\"stylesheet\" href=\"/style.css\"></head>\n<body><main><header><span class=\"eyebrow\">WEB NÂNG CAO · BLOCK 02</span><h1>Một màn hình, hai cách lấy dữ liệu.</h1><p>Quan sát browser ghép dữ liệu tuần tự và BFF ghép trên server.</p></header>\n<form id=\"controls\"><label>Luồng<select id=\"variant\"><option value=\"baseline\">Baseline · browser composition</option><option value=\"bff\">BFF · server composition</option></select></label><label>Client<select id=\"client\"><option value=\"web\">Web dashboard</option><option value=\"mobile\">Mobile orders</option></select></label><label>User<input id=\"userId\" value=\"U1\" required pattern=\"[A-Za-z0-9_-]{1,64}\"></label><button>Tải màn hình</button></form>\n<section class=\"summary\"><span id=\"state\">Sẵn sàng</span><span id=\"elapsed\">—</span></section><section id=\"screen\" data-state=\"idle\" aria-live=\"polite\"></section>\n<footer>Baseline: User → Order → Product từng đơn. BFF: User + Order → dedup → batch Product.<br>Mỗi lượt giữ dữ liệu thành công và đánh dấu phần lỗi. Dùng báo cáo evidence để xem call, SQL và payload.</footer></main><script type=\"module\" src=\"/app.js\"></script></body></html>\n"},"headersS