# Copy to .env, or run `npm run keygen` which creates .env with a fresh ES256 key.
AS_URL=http://localhost:4000
API_URL=http://localhost:4001
TAXI_URL=http://localhost:4002

AS_PORT=4000
API_PORT=4001
TAXI_PORT=4002

# ES256 private key (PKCS8 PEM, newlines escaped as \n). Generated by `npm run keygen`.
AS_PRIVATE_KEY_PEM=

# Lab TTLs (seconds)
CODE_TTL_SECONDS=60
ACCESS_TTL_SECONDS=120
REFRESH_TTL_SECONDS=604800

# Lab-only fake secrets (written by keygen)
TAXI_WEB_SECRET=
TAXI_M2M_SECRET=
TAXI_SESSION_SECRET=
